{
  "name": "kapiscout-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phanes-style Telegram scanner, call tracker and wallet alerts for Robinhood Chain.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "set-commands": "tsx scripts/set-commands.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "dotenv": "^16.6.1",
    "grammy": "^1.38.2",
    "sharp": "^0.35.3",
    "viem": "^2.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

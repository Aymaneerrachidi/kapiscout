# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# Free Robinhood Chain mainnet endpoints.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_WS_URL=
RH_CHAIN_ID=4663

BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/v2
BLOCKSCOUT_BROWSER_URL=https://robinhoodchain.blockscout.com
DEXSCREENER_CHAIN_ID=robinhood

DB_PATH=./data/kapiscout.db
BLOCK_POLL_INTERVAL_MS=4000
CALL_REFRESH_INTERVAL_MS=60000
SCAN_CACHE_TTL_MS=30000
MAX_WALLETS_PER_CHAT=5

# Optional global KOL list. Format: Label=0xAddress,Another Label=0xAddress
KOL_WALLETS=

